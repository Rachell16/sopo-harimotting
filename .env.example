# Setelah connect database di dashboard Vercel (Storage -> Create Database -> Postgres,
# via integrasi Neon), Vercel otomatis mengisi env var ini untuk deployment kamu.
# Untuk development lokal, salin file ini jadi .env.local lalu isi nilainya
# (ambil dari tab ".env.local" di halaman database Vercel/Neon kamu).
DATABASE_URL=

# PIN untuk masuk ke dashboard admin (Scan, Verifikasi, Jual, Stok, Laporan). Ganti sebelum dipakai beneran.
ADMIN_PIN=1234

# PIN untuk masuk ke dashboard manager (Laporan Keuangan, Absensi, Karyawan) — HARUS beda dari ADMIN_PIN.
MANAGER_PIN=9999
